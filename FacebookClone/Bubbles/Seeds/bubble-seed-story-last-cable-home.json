      },
      {
        "id": "walk",
        "emoji": "🚶",
        "speaker": "Priya",
        "text": "\"Shortcut,\" says Priya, pointing at a staircase into the fog. \"Or the bus. Your call. I'm here for the company.\"",
        "choices": [
          {
            "id": "stairs",
            "text": "Take the stairs",
