            "text": "Just enjoy the ride",
            "to": "ride",
            "past": "enjoyed the ride"
          }
        ]
      },
      {
        "id": "rang",
        "emoji": "🔔",
        "text": "Two short, one long. The whole car cheers. \"Not bad,\" says the gripman. \"Stay on to the turnaround if you like.\"",
        "choices": [
          {
            "id": "top",
            "text": "Ride to the top",
