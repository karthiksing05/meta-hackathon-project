      },
      {
        "id": "aboard",
        "emoji": "🚋",
        "speaker": "The gripman",
        "text": "\"Cutting it close!\" The gripman grins. \"Ever rung the bell? Two short, one long. Your stop's at the top.\"",
        "choices": [
          {
            "id": "ring",
            "text": "Ring the bell",
