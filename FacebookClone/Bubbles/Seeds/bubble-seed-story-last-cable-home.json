      },
      {
        "id": "ride",
        "emoji": "🌃",
        "text": "The city slides by in lit windows. The car crests the hill and the bay opens up below, dark and sparkling.",
        "choices": [
          {
            "id": "stop",
            "text": "Hop off at your stop",
            "to": "home",
            "past": "hopped off at their stop"
          }
