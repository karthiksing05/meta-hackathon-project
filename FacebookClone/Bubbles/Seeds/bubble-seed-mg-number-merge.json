      "inputs": {},
      "rules": [
        {
          "id": "cash_in",
          "on": "merged",
          "do": [
            {
              "incr": "score",
              "by": "event.value"
            }
          ]
        }
      ],
      "objectives": {
        "score": "score",
        "time_limit": "180s",
        "on_timeout": "lose"
      },
      "presentation": {
        "slots": [
          {
            "slot": "playfield",
            "node": {
              "node": "text",
              "x": 180,
              "y": 110,
              "anchor": "center",
              "size": 28,
              "weight": 700,
              "color": "$ink",
              "text": "= 'Score: ' + str(score)"
            }
          }
        ],
        "feedback": []
      },
      "look": {
        "id": "riso",
        "tokens": {}
      },
      "content": {},
      "playtest": {
        "progress": "score + 10 * count(values(board), v => v == 0)"
      }
    }
  },
