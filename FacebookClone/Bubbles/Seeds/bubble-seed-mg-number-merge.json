{
  "id": "mg-number-merge",
  "version": 1,
  "engine_version": 1,
  "title": "Number Merge",
  "one_line_rule": "Swipe or use the arrow keys to slide tiles.",
  "formula": "microgame",
  "brief": {
    "intent": "Swipe or use the arrow keys to slide tiles.",
    "audience": "everyone",
    "mood": [
      "playful"
    ],
    "energy": "medium",
    "competition": "friendly"
  },
  "structure": {
    "cadence": "endless",
    "scope": "everyone",
    "setter": "ai"
  },
  "lineage": {
    "parent": null,
    "operators": [],
    "remix_of": null
  },
  "chain": null,
  "style": {
    "look": "glow",
    "palette": "custom",
    "colors": {
      "bg_top": "#F3F1FA",
      "bg_bottom": "#F3F1FA",
      "ink": "#141414",
      "primary": "#5B4BDB",
      "secondary": "#FF6FAE",
      "accent": "#2BB3A3",
      "danger": "#FF6B6B"
    },
    "font": "rounded",
    "motif": "none",
    "emoji": "🔢",
    "mood_preset": "playful"
  },
  "concepts": [
    {
      "use": "space.microgame"
    },
    {
      "use": "input.microgame"
    },
    {
      "use": "score.microgame",
      "params": {
        "label": "points"
      }
    }
  ],
  "glue": {},
  "content": {
    "game": {
      "format": "microgame/0.1",
      "meta": {
        "title": "Number Merge",
        "instructions": "Swipe or use the arrow keys to slide tiles. Equal tiles merge. Reach 128.",
        "duration_s": 180
      },
      "types": {
        "MergeResult": {
          "cells": "list<int>",
          "gained": "int"
        }
      },
      "state": {
        "board": {
          "type": "grid<int>",
          "init": "grid(4, 4, 0)"
        },
        "score": {
          "type": "int",
          "init": "0"
        }
      },
      "functions": {
        "merge_line": {
          "params": {
            "line": "list<int>"
          },
          "returns": "MergeResult",
          "body": "let packed = fold(filter(line, v => v != 0), {out: [], locked: true, gained: 0}, (acc, v) => if not acc.locked and last(acc.out) == v then {out: set_at(acc.out, len(acc.out) - 1, v * 2), locked: true, gained: acc.gained + v * 2} else {out: push(acc.out, v), locked: false, gained: acc.gained}) in {cells: concat(packed.out, repeat(0, len(line) - len(packed.out))), gained: packed.gained}"
        },
        "can_move": {
          "params": {
            "b": "grid<int>"
          },
          "returns": "bool",
          "body": "any([up, down, left, right], d => any(lines(b, d), l => merge_line(map(l, c => b[c])).cells != map(l, c => b[c])))"
        },
        "best_tile": {
          "params": {},
          "returns": "int",
          "body": "fold(values(board), 0, (a, v) => max(a, v))"
        },
        "tile_slide__tile_fill": {
          "params": {
            "v": "int"
          },
          "returns": "string",
          "body": "get_or(['#DCD7F0', '#C7D7FA', '#A9C1F7', '#8BA8F2', '#7C8CEB', '#8A72E0', '#9B5BD6', '#B347C9', '#D6479E', '#E0596B', '#E88A4B', '#EDB83C', '#6BAF7B'], round(log2(max(v, 1))), '#3C3A32')"
        }
      },
      "events": {
        "spawn_tile": {},
        "slid": {},
        "merged": {
          "value": "int"
        }
      },
      "inputs": {
        "tile_slide__slide": {
          "payload": {
            "dir": "ivec2"
          },
          "from": [
            {
              "swipe": "any",
              "with": {
                "dir": "swipe.dir"
              }
            },
            {
              "key": "ArrowUp",
              "with": {
                "dir": "up"
              }
            },
            {
              "key": "ArrowDown",
              "with": {
                "dir": "down"
              }
            },
            {
              "key": "ArrowLeft",
              "with": {
                "dir": "left"
              }
            },
            {
              "key": "ArrowRight",
              "with": {
                "dir": "right"
              }
            }
          ]
        }
      },
      "rules": [
        {
          "id": "tile_slide__setup",
          "on": "start",
          "do": [
            {
              "for_each": "range(2)",
              "as": "n",
              "do": [
                {
                  "emit": "spawn_tile"
                }
              ]
            }
          ]
        },
        {
          "id": "tile_slide__spawn",
          "on": "spawn_tile",
          "when": "any(values(board), v => v == 0)",
          "do": [
            {
              "let": {
                "spot": "pick(filter(cells(board), c => board[c] == 0))"
              }
            },
            {
              "set": "board[spot]",
              "to": "weighted([2, 2 * 2], [100 - 10, 10])"
            }
          ]
        },
        {
          "id": "tile_slide__slide",
          "on": "tile_slide__slide",
          "do": [
            {
              "let": {
                "before": "board"
              }
            },
            {
              "for_each": "lines(board, event.dir)",
              "as": "line",
              "do": [
                {
                  "let": {
                    "r": "merge_line(map(line, c => board[c]))"
                  }
                },
                {
                  "set": "board",
                  "to": "write_line(board, line, r.cells)"
                },
                {
                  "if": "r.gained > 0",
                  "then": [
                    {
                      "emit": "merged",
                      "with": {
                        "value": "r.gained"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "if": "board != before",
              "then": [
                {
                  "emit": "slid"
                },
                {
                  "emit": "spawn_tile"
                }
              ]
            }
          ]
        },
        {
          "id": "cash_in",
          "on": "merged",
          "do": [
            {
              "incr": "score",
              "by": "event.value"
            }
          ]
        }
      ],
      "objectives": {
        "win": "any(values(board), v => v >= 128)",
        "lose": "not can_move(board)",
        "score": "score",
        "time_limit": "180s",
        "on_timeout": "lose"
      },
      "presentation": {
        "canvas": {
          "w": 360,
          "h": 640,
          "background": "$bg"
        },
        "tokens": {
          "primary": "#5B4BDB",
          "secondary": "#FF6FAE",
          "accent": "#2BB3A3",
          "ink": "#2A2357",
          "bg": "#F3F1FA",
          "surface": "#DCD7F0",
          "danger": "#E2445C"
        },
        "root": {
          "node": "group",
          "children": [
            {
              "node": "group",
              "x": 0,
              "y": 0,
              "children": [
                {
                  "node": "rect",
                  "x": "= 16 - 8",
                  "y": "= 170 - 8",
                  "w": "= 4 * 76 + (4 - 1) * 8 + 16",
                  "h": "= 4 * 76 + (4 - 1) * 8 + 16",
                  "radius": 12,
                  "fill": "$surface"
                },
                {
                  "node": "grid",
                  "source": "board",
                  "cell_size": 76,
                  "gap": 8,
                  "x": 16,
                  "y": 170,
                  "cell": {
                    "node": "group",
                    "children": [
                      {
                        "node": "rect",
                        "w": 76,
                        "h": 76,
                        "radius": 8,
                        "fill": "= if value == 0 then '#00000022' else tile_slide__tile_fill(value)",
                        "transition": {
                          "fill": {
                            "ms": 100,
                            "ease": "out"
                          }
                        },
                        "animate_on": {
                          "spawn_tile": {
                            "when": "value != 0",
                            "prop": "scale",
                            "keys": [
                              0.9,
                              1.05,
                              1
                            ],
                            "ms": 120
                          }
                        }
                      },
                      {
                        "node": "text",
                        "w": 76,
                        "h": 76,
                        "align": "center",
                        "valign": "middle",
                        "text": "= if value == 0 then '' else str(value)",
                        "size": "= if value >= 1000 then 22 else if value >= 100 then 28 else 34",
                        "weight": 700,
                        "color": "= if value <= 4 * 2 then $ink else '#FFFFFF'",
                        "font": "Space Grotesk"
                      }
                    ]
                  }
                },
                {
                  "node": "text",
                  "x": 180,
                  "y": 110,
                  "anchor": "center",
                  "size": 28,
                  "weight": 700,
                  "color": "$ink",
                  "text": "= 'Score: ' + str(score)",
                  "font": "Space Grotesk"
                }
              ]
            },
            {
              "node": "stack",
              "dir": "row",
              "gap": 24,
              "align": "center",
              "x": 180,
              "y": 52,
              "anchor": "center",
              "children": []
            },
            {
              "node": "stack",
              "dir": "row",
              "gap": 24,
              "align": "center",
              "x": 180,
              "y": 604,
              "anchor": "center",
              "children": []
            },
            {
              "node": "group",
              "x": 0,
              "y": 0,
              "children": []
            }
          ]
        },
        "feedback": [
          {
            "on": "slid",
            "do": [
              {
                "sound": {
                  "wave": "sine",
                  "note": "A4",
                  "ms": 40
                }
              }
            ]
          },
          {
            "on": "merged",
            "do": [
              {
                "sound": {
                  "wave": "triangle",
                  "note": "E5",
                  "ms": 80
                }
              }
            ]
          },
          {
            "on": "win",
            "do": [
              {
                "sound": {
                  "wave": "triangle",
                  "note": "C6",
                  "ms": 300
                }
              }
            ]
          }
        ]
      }
    },
    "authoring": {
      "authoring": "microgame-authoring/0.1",
      "meta": {
        "title": "Number Merge",
        "instructions": "Swipe or use the arrow keys to slide tiles. Equal tiles merge. Reach 128.",
        "duration_s": 180
      },
      "uses": [
