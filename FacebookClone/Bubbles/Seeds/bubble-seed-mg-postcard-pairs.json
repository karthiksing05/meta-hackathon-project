          },
          "returns": "string",
          "body": "get_or(['P', 'B', 'T', 'M', 'F', 'W', 'H', 'K'], s, '?')"
        },
        "shown": {
          "params": {
            "c": "ivec2"
          },
          "returns": "bool",
          "body": "let i = c.y * 4 + c.x in i < len(cards) and (hint_active or cards[i].revealed or cards[i].matched)"
        },
        "cell_fill": {
          "params": {
            "c": "ivec2"
          },
          "returns": "string",
          "body": "if shown(c) then face_color(cards[c.y * 4 + c.x].symbol) else ''"
        },
