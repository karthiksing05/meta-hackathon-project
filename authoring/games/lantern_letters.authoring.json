{
  "authoring": "microgame-authoring/0.1",
  "meta": {
    "title": "Lantern Letters",
    "instructions": "Light up five hidden words, one letter at a time. Eight wrong letters and the lanterns go out.",
    "duration_s": 180
  },
  "uses": [
    {
      "fragment": "lives",
      "params": {
        "count": 8
      }
    },
    {
      "fragment": "score",
      "params": {
        "points": 10,
        "target": 0,
        "label": "Score"
      }
    },
    {
      "fragment": "rounds",
      "params": {
        "count": 5,
        "label": "Word"
      }
    },
    {
      "fragment": "keyboard"
    }
  ],
  "state": {
    "order": {
      "type": "list<string>",
      "init": "[]"
    },
    "guessed": {
      "type": "set<string>",
      "init": "set_of([])"
    }
  },
  "events": {
    "hit": {},
    "round_done": {}
  },
  "rules": [
    {
      "id": "pick_words",
      "on": "start",
      "do": [
        {
          "set": "order",
          "to": "take(shuffle(content_words), 5)"
        }
      ]
    },
    {
      "id": "guess",
      "on": "press",
      "when": "event.letter != '' and not has(guessed, event.letter) and round < len(order)",
      "do": [
        {
          "set": "guessed",
          "to": "add(guessed, event.letter)"
        },
        {
          "let": {
            "w": "get_or(order, round, '')"
          }
        },
        {
          "if": "contains(chars(w), event.letter)",
          "then": [
            {
              "emit": "point"
            }
          ],
          "else": [
            {
              "emit": "hit"
            }
          ]
        },
        {
          "if": "all(chars(w), c => has(guessed, c))",
          "then": [
            {
              "emit": "round_done"
            }
          ]
        }
      ]
    },
    {
      "id": "next_word",
      "on": "round_done",
      "do": [
        {
          "set": "guessed",
          "to": "set_of([])"
        }
      ]
    }
  ],
  "objectives": {
    "time_limit": "180s",
    "on_timeout": "lose"
  },
  "presentation": {
    "slots": [
      {
        "slot": "playfield",
        "node": {
          "node": "text",
          "x": 180,
          "y": 230,
          "anchor": "center",
          "size": 40,
          "weight": 700,
          "color": "$ink",
          "text": "= join(map(chars(get_or(order, round, '')), c => if has(guessed, c) then upper(c) else '_'), ' ')"
        }
      }
    ],
    "feedback": [
      {
        "on": "hit",
        "do": [
          {
            "sound": {
              "wave": "square",
              "note": "C3",
              "ms": 120
            }
          }
        ]
      },
      {
        "on": "round_done",
        "do": [
          {
            "sound": {
              "wave": "triangle",
              "note": "G5",
              "ms": 160
            }
          }
        ]
      },
      {
        "on": "win",
        "do": [
          {
            "sound": {
              "wave": "triangle",
              "note": "C6",
              "ms": 300
            }
          }
        ]
      }
    ]
  },
  "look": {
    "id": "paper",
    "tokens": {}
  },
  "content": {
    "words": [
      "picnic",
      "ferry",
      "mural",
      "hike",
      "tacos",
      "museum",
      "karaoke",
      "market",
      "bikes",
      "concert",
      "garden",
      "bakery"
    ]
  },
  "playtest": {
    "progress": "score + round * 100"
  },
  "functions": {
    "key_state": {
      "params": {
        "letter": "string"
      },
      "returns": "int",
      "body": "if not has(guessed, letter) then 0 else if contains(chars(get_or(order, round, '')), letter) then 1 else 2"
    }
  }
}
