{
  "authoring": "microgame-authoring/0.1",
  "meta": {
    "title": "Snake",
    "instructions": "Swipe or use the arrow keys to steer. Eat 10 apples. Don't hit the walls or yourself.",
    "duration_s": 120
  },
  "uses": [
    {
      "fragment": "score",
      "params": {
        "target": 10,
        "label": "Apples"
      }
    }
  ],
  "state": {
    "snake": {
      "type": "list<ivec2>",
      "init": "[vec(4, 7), vec(3, 7), vec(2, 7)]"
    },
    "dir": {
      "type": "ivec2",
      "init": "right"
    },
    "next_dir": {
      "type": "ivec2",
      "init": "right"
    },
    "food": {
      "type": "ivec2",
      "init": "vec(10, 7)"
    }
  },
  "inputs": {
    "steer": {
      "payload": {
        "dir": "ivec2"
      },
      "from": [
        {
          "swipe": "any",
          "with": {
            "dir": "swipe.dir"
          }
        },
        {
          "key": "ArrowUp",
          "with": {
            "dir": "up"
          }
        },
        {
          "key": "ArrowDown",
          "with": {
            "dir": "down"
          }
        },
        {
          "key": "ArrowLeft",
          "with": {
            "dir": "left"
          }
        },
        {
          "key": "ArrowRight",
          "with": {
            "dir": "right"
          }
        }
      ]
    }
  },
  "rules": [
    {
      "id": "steer",
      "on": "steer",
      "when": "event.dir + dir != vec(0, 0)",
      "do": [
        {
          "set": "next_dir",
          "to": "event.dir"
        }
      ]
    },
    {
      "id": "move",
      "on": {
        "every": "150ms"
      },
      "do": [
        {
          "set": "dir",
          "to": "next_dir"
        },
        {
          "let": {
            "head": "snake[0] + dir"
          }
        },
        {
          "if": "not in_bounds(head, 15, 15) or contains(take(snake, len(snake) - 1), head)",
          "then": [
            {
              "end": "lose"
            }
          ]
        },
        {
          "if": "head == food",
          "then": [
            {
              "set": "snake",
              "to": "concat([head], snake)"
            },
            {
              "emit": "point"
            },
            {
              "set": "food",
              "to": "pick(filter(coords(15, 15), c => not contains(snake, c)))"
            }
          ],
          "else": [
            {
              "set": "snake",
              "to": "concat([head], take(snake, len(snake) - 1))"
            }
          ]
        }
      ]
    }
  ],
  "objectives": {
    "time_limit": "120s",
    "on_timeout": "lose"
  },
  "presentation": {
    "slots": [
      {
        "slot": "playfield",
        "node": {
          "node": "grid",
          "cols": 15,
          "rows": 15,
          "cell_size": 22,
          "gap": 1,
          "x": 8,
          "y": 148,
          "cell": {
            "node": "rect",
            "w": 22,
            "h": 22,
            "radius": 4,
            "role": "tile",
            "fill": "= if cell == food then $food else if cell == snake[0] then $head else if contains(snake, cell) then $body else $surface"
          }
        }
      }
    ],
    "feedback": [
      {
        "on": "lose",
        "do": [
          {
            "shake": {
              "px": 8,
              "ms": 300
            }
          },
          {
            "sound": {
              "wave": "square",
              "note": "C3",
              "ms": 250
            }
          }
        ]
      },
      {
        "on": "win",
        "do": [
          {
            "sound": {
              "wave": "triangle",
              "note": "C6",
              "ms": 300
            }
          }
        ]
      }
    ]
  },
  "look": {
    "id": "pixel",
    "tokens": {
      "body": "#7BD389",
      "head": "#C6F6CF",
      "food": "#FF5D5D"
    }
  },
  "content": {},
  "playtest": {
    "progress": "score * 100 - abs(snake[0].x - food.x) - abs(snake[0].y - food.y)"
  }
}
