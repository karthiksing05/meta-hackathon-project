{
  "authoring": "microgame-authoring/0.1",
  "meta": {
    "title": "Postcard Pairs",
    "instructions": "Match the postcards from around your new city. Tap two to flip them. Nine slips and the mail is lost.",
    "duration_s": 90
  },
  "uses": [
    {
      "fragment": "grid_board",
      "params": {
        "cols": 4,
        "rows": 4,
        "cell_size": 64,
        "gap": 8,
        "x": 36,
        "y": 180
      }
    },
    {
      "fragment": "match_pairs",
      "params": {
        "pairs": 8,
        "cols": 4,
        "mismatch_ms": 800
      }
    },
    {
      "fragment": "hint",
      "params": {
        "uses": 2,
        "cooldown": 2500
      }
    },
    {
      "fragment": "score",
      "params": {
        "points": 100,
        "label": "Score"
      },
      "bind": {
        "point": "pair_found"
      }
    },
    {
      "fragment": "lives",
      "params": {
        "count": 9
      },
      "bind": {
        "hit": "pair_missed"
      }
    }
  ],
  "functions": {
    "face_color": {
      "params": {
        "s": "int"
      },
      "returns": "string",
      "body": "get_or(['#E4572E', '#3A6EA5', '#6BAF7B', '#E9B44C', '#8E5BA8', '#2FA5A0', '#D9638A', '#7A6A55'], s, '#7A6A55')"
    },
    "face_letter": {
      "params": {
        "s": "int"
      },
      "returns": "string",
      "body": "get_or(['P', 'B', 'T', 'M', 'F', 'W', 'H', 'K'], s, '?')"
    },
    "shown": {
      "params": {
        "c": "ivec2"
      },
      "returns": "bool",
      "body": "let i = c.y * 4 + c.x in i < len(cards) and (hint_active or cards[i].revealed or cards[i].matched)"
    },
    "cell_fill": {
      "params": {
        "c": "ivec2"
      },
      "returns": "string",
      "body": "if shown(c) then face_color(cards[c.y * 4 + c.x].symbol) else ''"
    },
    "cell_label": {
      "params": {
        "c": "ivec2"
      },
      "returns": "string",
      "body": "if shown(c) then face_letter(cards[c.y * 4 + c.x].symbol) else ''"
    }
  },
  "objectives": {
    "time_limit": "90s",
    "on_timeout": "lose",
    "score": "matches * 100"
  },
  "presentation": {
    "slots": [
      {
        "slot": "playfield",
        "node": {
          "node": "text",
          "text": "POSTCARD PAIRS",
          "x": 180,
          "y": 120,
          "anchor": "center",
          "size": 26,
          "weight": 700,
          "color": "$ink"
        }
      }
    ],
    "feedback": []
  },
  "look": {
    "id": "paper",
    "tokens": {}
  },
  "content": {},
  "playtest": {
    "progress": "matches * 100 + lives"
  }
}
