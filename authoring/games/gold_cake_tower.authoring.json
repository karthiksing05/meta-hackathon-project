        "#6E9E4A",
        "#F2A93B",
        "#4A2C2A",
        "#6B5BD6"
      ]
    }
  },
  "art": {
    "style": "A cozy morning bakery: peach wallpaper with little diamonds, bunting, jars on shelves, a lilac cake stand and pastel sponge layers (strawberry, matcha, lemon, cocoa, blueberry) with frosting drips and a cherry on top.",
    "palette": {
      "bg": "#FFF1E2",
      "surface": "#F6D9C0",
      "primary": "#E0457B",
      "secondary": "#7AC7A8",
      "accent": "#E58A1F",
      "ink": "#4A2C2A",
      "danger": "#D93B3B"
    },
