{
  "authoring": "microgame-authoring/0.1",
  "meta": {
    "title": "Cake Tower",
    "instructions": "Tap to drop the sliding layer onto the cake. Whatever hangs over the edge gets sliced off, so line it up. Perfect drops grow the cake back a little and build a combo. Stack 24 layers to add the cherry; three layers on the floor and the bakery closes.",
    "duration_s": 60
  },
  "uses": [
    {
      "fragment": "lives",
      "params": {
        "count": 3
      },
      "bind": {
        "hit": "slip"
      }
    },
    {
      "fragment": "score",
      "params": {
        "points": 10,
        "label": "Score"
      }
    },
    {
      "fragment": "combo",
      "params": {
        "step": 1,
        "max": 8,
        "label": "Combo"
      },
      "bind": {
        "hit_good": "perfect",
        "hit_bad": "sloppy"
      }
    }
  ],
  "types": {
    "Layer": {
      "id": "int",
      "x": "float",
      "w": "float",
      "flavor": "int",
      "perfect": "bool"
    },
    "Piece": {
      "id": "int",
      "x": "float",
      "y": "float",
      "w": "float",
      "vy": "float",
      "spin": "float",
      "flavor": "int"
    },
    "Pop": {
      "id": "int",
      "x": "float",
      "y": "float",
      "born": "int",
      "text": "string"
    }
  },
  "state": {
    "layers": {
      "type": "list<Layer>",
      "init": "[{id: 0, x: 180.0, w: 200.0, flavor: 0, perfect: false}]"
    },
    "mx": {
      "type": "float",
      "init": "75.0"
    },
    "mw": {
      "type": "float",
      "init": "200.0"
    },
    "mdir": {
      "type": "float",
      "init": "1.0"
    },
    "pieces": {
      "type": "list<Piece>",
      "init": "[]"
    },
    "pops": {
      "type": "list<Pop>",
      "init": "[]"
    },
    "seq": {
      "type": "int",
      "init": "1"
    },
    "view": {
      "type": "float",
      "init": "0.0"
    },
    "built": {
      "type": "bool",
      "init": "false"
    },
    "topped": {
      "type": "bool",
      "init": "false"
    }
  },
  "functions": {
    "slide_speed": {
      "params": {},
      "returns": "float",
      "body": "min(260.0, 110.0 + 6.0 * len(layers))"
    },
    "aligned": {
      "params": {},
      "returns": "bool",
      "body": "abs(mx - last(layers).x) <= 7.0"
    }
  },
  "events": {
    "perfect": {},
    "sloppy": {},
    "slip": {},
    "topper": {}
  },
  "inputs": {
    "drop": {
      "payload": {},
      "when": "not built",
      "from": [
        {
          "key": " ",
          "with": {}
        }
      ]
    }
  },
  "rules": [
    {
      "id": "slide",
      "on": "tick",
      "when": "not built",
      "do": [
        {
          "let": {
            "nx": "mx + mdir * slide_speed() * event.dt / 1000.0"
          }
        },
        {
          "set": "mdir",
          "to": "if nx > 285.0 then -1.0 else if nx < 75.0 then 1.0 else mdir"
        },
        {
          "set": "mx",
          "to": "clamp(nx, 75.0, 285.0)"
        }
      ]
    },
    {
      "id": "camera",
      "on": "tick",
      "do": [
        {
          "set": "view",
          "to": "view + (max(0.0, (len(layers) - 10) * 24.0) - view) * min(1.0, event.dt / 220.0)"
        },
        {
          "set": "pieces",
          "to": "map(pieces, p => {...p, vy: p.vy + 1500.0 * event.dt / 1000.0, y: p.y + p.vy * event.dt / 1000.0, spin: p.spin + (if p.x > 180.0 then 160.0 else -160.0) * event.dt / 1000.0})"
        },
        {
          "remove": "pieces",
          "where": "p => p.y + view > 700.0"
        },
        {
          "remove": "pops",
          "where": "p => now - p.born > 800"
        }
      ]
    },
    {
      "id": "drop",
      "on": "drop",
      "do": [
        {
          "let": {
            "top": "last(layers)"
          }
        },
        {
          "let": {
            "n": "len(layers)"
          }
        },
        {
          "let": {
            "lo": "max(mx - mw / 2.0, top.x - top.w / 2.0)",
            "hi": "min(mx + mw / 2.0, top.x + top.w / 2.0)"
          }
        },
        {
          "let": {
            "wy": "560.0 - (n + 1) * 24.0"
          }
        },
        {
          "if": "aligned()",
          "then": [
            {
              "let": {
                "grown": "min(200.0, top.w + 8.0)"
              }
            },
            {
              "push": "layers",
              "value": "{id: seq, x: top.x, w: grown, flavor: n % 5, perfect: true}"
            },
            {
              "set": "mw",
              "to": "grown"
            },
            {
              "emit": "perfect"
            },
            {
              "emit": "point"
            }
          ],
          "else": [
            {
              "if": "hi > lo",
              "then": [
                {
                  "push": "layers",
                  "value": "{id: seq, x: (lo + hi) / 2.0, w: hi - lo, flavor: n % 5, perfect: false}"
                },
                {
                  "push": "pieces",
                  "value": "{id: seq, x: if mx > top.x then (hi + mx + mw / 2.0) / 2.0 else (mx - mw / 2.0 + lo) / 2.0, y: wy + 12.0, w: mw - (hi - lo), vy: -120.0, spin: 0.0, flavor: n % 5}"
                },
                {
                  "set": "mw",
                  "to": "hi - lo"
                },
                {
                  "emit": "sloppy"
                },
                {
                  "emit": "point"
                }
              ],
              "else": [
                {
                  "push": "pieces",
                  "value": "{id: seq, x: mx, y: wy + 12.0, w: mw, vy: -80.0, spin: 0.0, flavor: n % 5}"
                },
                {
                  "push": "pops",
                  "value": "{id: seq, x: mx, y: wy + view - 10.0, born: now, text: 'Splat!'}"
                },
                {
                  "emit": "sloppy"
                },
                {
                  "emit": "slip"
                }
              ]
            }
          ]
        },
        {
          "incr": "seq"
        },
        {
          "set": "mx",
          "to": "if n % 2 == 0 then 285.0 else 75.0"
        },
        {
          "set": "mdir",
          "to": "if n % 2 == 0 then -1.0 else 1.0"
        },
        {
          "if": "len(layers) >= 25",
          "then": [
            {
              "set": "built",
              "to": "true"
            },
            {
              "after": "900ms",
              "emit": "topper",
              "id": "topper_timer"
            }
          ]
        }
      ]
    },
    {
      "id": "perfect_bonus",
      "on": "perfect",
      "do": [
        {
          "incr": "score",
          "by": "10 * combo"
        },
        {
          "push": "pops",
          "value": "{id: seq, x: last(layers).x, y: 560.0 - len(layers) * 24.0 + view - 22.0, born: now, text: 'Perfect! +' + str(10 + 10 * combo)}"
        },
        {
          "incr": "seq"
        }
      ]
    },
    {
      "id": "cherry_on_top",
      "on": "topper",
      "do": [
        {
          "incr": "score",
          "by": "100 * lives"
        },
        {
          "set": "topped",
          "to": "true"
        }
      ]
    }
  ],
  "objectives": {
    "win": "topped"
  },
  "presentation": {
    "slots": [
      {
        "slot": "playfield",
        "node": {
          "node": "rect",
          "w": 360,
          "h": 640,
          "fill": "#00000000",
          "on_tap": {
            "input": "drop",
            "with": {}
          }
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "repeat",
          "source": "range(5)",
          "as": "k",
          "key": "k",
          "template": {
            "node": "group",
            "children": [
              {
                "node": "rect",
                "x": 0,
                "y": "= 560.0 - (k * 5 + 5) * 24.0 + view",
                "w": "= if k == 4 then 360.0 else 16.0",
                "h": 2,
                "fill": "= if k == 4 then $primary else $ink",
                "opacity": "= if k == 4 then 0.6 else 0.3"
              },
              {
                "node": "text",
                "text": "= if k == 4 then 'Cherry line' else str(k * 5 + 5)",
                "x": 20,
                "y": "= 560.0 - (k * 5 + 5) * 24.0 + view - 8.0",
                "size": 13,
                "weight": 700,
                "color": "= if k == 4 then $primary else $ink",
                "opacity": 0.6
              }
            ]
          }
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "image",
          "asset": "stand",
          "x": 60,
          "y": "= 557.0 + view",
          "w": 240,
          "h": 64
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "repeat",
          "source": "layers",
          "as": "l",
          "key": "l.id",
          "template": {
            "node": "group",
            "animate_on": {
              "perfect": {
                "when": "l.id == last(layers).id",
                "prop": "scale",
                "keys": [
                  1,
                  1.08,
                  1
                ],
                "ms": 200
              }
            },
            "children": [
              {
                "node": "rect",
                "x": "= l.x - l.w / 2.0",
                "y": "= 560.0 - (index + 1) * 24.0 + view",
                "w": "= l.w",
                "h": 24,
                "radius": 6,
                "fill": "= $sponge[l.flavor]",
                "stroke": "#7A4E3A",
                "stroke_width": 1.5
              },
              {
                "node": "rect",
                "x": "= l.x - l.w / 2.0 + 3.0",
                "y": "= 560.0 - (index + 1) * 24.0 + view + 14.0",
                "w": "= max(0.0, l.w - 6.0)",
                "h": 3,
                "radius": 1.5,
                "fill": "= $jam[l.flavor]"
              },
              {
                "node": "rect",
                "x": "= l.x - l.w / 2.0",
                "y": "= 560.0 - (index + 1) * 24.0 + view",
                "w": "= l.w",
                "h": 8,
                "radius": 4,
                "fill": "= $cream[l.flavor]"
              },
              {
                "node": "circle",
                "x": "= l.x - l.w / 2.0 + l.w * 0.2",
                "y": "= 560.0 - (index + 1) * 24.0 + view + 8.0",
                "r": 3.5,
                "fill": "= $cream[l.flavor]",
                "visible": "= l.w > 36.0"
              },
              {
                "node": "circle",
                "x": "= l.x - l.w / 2.0 + l.w * 0.5",
                "y": "= 560.0 - (index + 1) * 24.0 + view + 8.0",
                "r": 3.5,
                "fill": "= $cream[l.flavor]",
                "visible": "= l.w > 36.0"
              },
              {
                "node": "circle",
                "x": "= l.x - l.w / 2.0 + l.w * 0.8",
                "y": "= 560.0 - (index + 1) * 24.0 + view + 8.0",
                "r": 3.5,
                "fill": "= $cream[l.flavor]",
                "visible": "= l.w > 36.0"
              },
              {
                "node": "image",
                "asset": "sparkle",
                "anchor": "center",
                "x": "= l.x + l.w / 2.0 - 8.0",
                "y": "= 560.0 - (index + 1) * 24.0 + view + 4.0",
                "w": 14,
                "h": 14,
                "visible": "= l.perfect",
                "rotation": "= fmod(now / 12.0 + index * 40.0, 360.0)"
              }
            ]
          }
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "group",
          "visible": "= not built",
          "children": [
            {
              "node": "rect",
              "x": "= last(layers).x - last(layers).w / 2.0 - 1.0",
              "y": "= 560.0 - len(layers) * 24.0 + view - 70.0",
              "w": 2,
              "h": 70,
              "fill": "$ink",
              "opacity": 0.14
            },
            {
              "node": "rect",
              "x": "= last(layers).x + last(layers).w / 2.0 - 1.0",
              "y": "= 560.0 - len(layers) * 24.0 + view - 70.0",
              "w": 2,
              "h": 70,
              "fill": "$ink",
              "opacity": 0.14
            }
          ]
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "group",
          "visible": "= not built",
          "children": [
            {
              "node": "rect",
              "x": "= mx - mw / 2.0",
              "y": "= 560.0 - (len(layers) + 1) * 24.0 + view",
              "w": "= mw",
              "h": 24,
              "radius": 6,
              "fill": "= $sponge[len(layers) % 5]",
              "stroke": "= if aligned() then '#FFFFFF' else '#7A4E3A'",
              "stroke_width": "= if aligned() then 3.0 else 1.5"
            },
            {
              "node": "rect",
              "x": "= mx - mw / 2.0 + 3.0",
              "y": "= 560.0 - (len(layers) + 1) * 24.0 + view + 14.0",
              "w": "= max(0.0, mw - 6.0)",
              "h": 3,
              "radius": 1.5,
              "fill": "= $jam[len(layers) % 5]"
            },
            {
              "node": "rect",
              "x": "= mx - mw / 2.0",
              "y": "= 560.0 - (len(layers) + 1) * 24.0 + view",
              "w": "= mw",
              "h": 8,
              "radius": 4,
              "fill": "= $cream[len(layers) % 5]"
            },
            {
              "node": "circle",
              "x": "= mx - mw / 2.0 + mw * 0.2",
              "y": "= 560.0 - (len(layers) + 1) * 24.0 + view + 8.0",
              "r": 3.5,
              "fill": "= $cream[len(layers) % 5]",
              "visible": "= mw > 36.0"
            },
            {
              "node": "circle",
              "x": "= mx - mw / 2.0 + mw * 0.5",
              "y": "= 560.0 - (len(layers) + 1) * 24.0 + view + 8.0",
              "r": 3.5,
              "fill": "= $cream[len(layers) % 5]",
              "visible": "= mw > 36.0"
            },
            {
              "node": "circle",
              "x": "= mx - mw / 2.0 + mw * 0.8",
              "y": "= 560.0 - (len(layers) + 1) * 24.0 + view + 8.0",
              "r": 3.5,
              "fill": "= $cream[len(layers) % 5]",
              "visible": "= mw > 36.0"
            }
          ]
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "repeat",
          "source": "pieces",
          "as": "p",
          "key": "p.id",
          "template": {
            "node": "rect",
            "anchor": "center",
            "x": "= p.x",
            "y": "= p.y + view",
            "w": "= p.w",
            "h": 24,
            "radius": 6,
            "rotation": "= p.spin",
            "fill": "= $sponge[p.flavor]",
            "stroke": "#7A4E3A",
            "stroke_width": 1.5
          }
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "image",
          "asset": "cherry",
          "anchor": "center",
          "x": "= last(layers).x",
          "y": "= 560.0 - len(layers) * 24.0 + view - 22.0",
          "w": 48,
          "h": 56,
          "visible": "= topped",
          "animate_on": {
            "topper": {
              "prop": "scale",
              "keys": [
                0.2,
                1.3,
                1
              ],
              "ms": 360
            }
          }
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "repeat",
          "source": "pops",
          "as": "p",
          "key": "p.id",
          "template": {
            "node": "text",
            "text": "= p.text",
            "anchor": "center",
            "x": "= clamp(p.x, 70.0, 290.0)",
            "y": "= p.y - (now - p.born) * 0.04",
            "size": 18,
            "weight": 700,
            "color": "= if p.text == 'Splat!' then $danger else $primary",
            "stroke": "#FFFFFF",
            "stroke_width": 4,
            "opacity": "= 1.0 - (now - p.born) / 800.0"
          }
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "rect",
          "x": 10,
          "y": 28,
          "w": 340,
          "h": 40,
          "radius": 20,
          "fill": "#FFFFFF",
          "opacity": 0.75
        }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "rect",
          "x": 110,
          "y": 594,
          "w": 140,
          "h": 28,
          "radius": 14,
          "fill": "#FFFFFF",
          "opacity": 0.75
        }
      },
      {
        "slot": "hud_bottom",
        "node": {
          "node": "text",
          "text": "= 'Layer ' + str(min(24, len(layers) - 1)) + ' of 24'",
          "size": 16,
          "weight": 700,
          "color": "$ink",
          "role": "hud"
        }
      }
    ],
    "feedback": [
      {
        "on": "point",
        "do": [
          {
            "sound": {
              "wave": "triangle",
              "note": "= 196.0 + len(layers) * 12.0",
              "ms": 90,
              "volume": 0.5
            }
          },
          {
            "particles": {
              "x": "= last(layers).x",
              "y": "= 560.0 - len(layers) * 24.0 + view + 20.0",
              "count": 10,
              "color": "#F6D9C0",
              "speed": 120,
              "size": 4,
              "ms": 380,
              "gravity": 500,
              "spread": 180
            }
          },
          {
            "haptic": "light"
          }
        ]
      },
      {
        "on": "perfect",
        "do": [
          {
            "sound": {
              "wave": "sine",
              "note": "= 784.0 * pow(1.0595, min(combo, 10) * 2.0)",
              "ms": 160,
              "volume": 0.45
            }
          },
          {
            "particles": {
              "x": "= last(layers).x - last(layers).w / 2.0",
              "y": "= 560.0 - len(layers) * 24.0 + view + 6.0",
              "count": 12,
              "color": "#FFFFFF",
              "speed": 160,
              "size": 4,
              "ms": 450
            }
          },
          {
            "particles": {
              "x": "= last(layers).x + last(layers).w / 2.0",
              "y": "= 560.0 - len(layers) * 24.0 + view + 6.0",
              "count": 12,
              "color": "#FFB547",
              "speed": 160,
              "size": 4,
              "ms": 450
            }
          },
          {
            "haptic": "medium"
          }
        ]
      },
      {
        "on": "slip",
        "do": [
          {
            "moment": "hit"
          }
        ]
      },
      {
        "on": "topper",
        "do": [
          {
            "moment": "level"
          },
          {
            "particles": {
              "x": "= last(layers).x",
              "y": "= 560.0 - len(layers) * 24.0 + view - 20.0",
              "count": 30,
              "color": "#FF7AA2",
              "speed": 260,
              "size": 6,
              "ms": 900,
              "gravity": 400
            }
          }
        ]
      }
    ]
  },
  "look": {
