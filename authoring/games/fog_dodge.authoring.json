{
  "authoring": "microgame-authoring/0.1",
  "meta": {
    "title": "Fog Dodge",
    "instructions": "Drag or use the arrow keys to steer your cable car through the fog. Survive 45 seconds.",
    "duration_s": 45
  },
  "uses": [
    {
      "fragment": "player_drag",
      "params": {
        "axis": "x",
        "start_x": 180.0,
        "start_y": 560.0,
        "margin": 20.0,
        "size": 14.0,
        "tone": "primary"
      }
    },
    {
      "fragment": "lives",
      "params": {
        "count": 5
      }
    },
    {
      "fragment": "collide",
      "params": {
        "radius": 32.0,
        "grace": 1200
      }
    },
    {
      "fragment": "spawn_wave",
      "params": {
        "from": "top",
        "every": "700ms",
        "speed": 140.0,
        "radius": 18.0,
        "jitter": 0.3,
        "max_alive": 14,
        "kind": "fog"
      }
    },
    {
      "fragment": "speed_ramp",
      "params": {
        "every": 6000,
        "step": 0.1
      }
    },
    {
      "fragment": "countdown",
      "params": {
        "on_end": "none"
      }
    }
  ],
  "rules": [
    {
      "id": "clear",
      "on": "hit",
      "do": [
        {
          "remove": "spawns",
          "where": "s => dist(vec(s.x, s.y), hit_at) < 40.0"
        }
      ]
    }
  ],
  "objectives": {
    "score": "now / 100",
    "time_limit": "45s",
    "on_timeout": "win"
  },
  "presentation": {
    "slots": [],
    "feedback": [
      {
        "on": "hit",
        "do": [
          {
            "sound": {
              "wave": "sawtooth",
              "note": "C2",
              "ms": 200
            }
          }
        ]
      },
      {
        "on": "win",
        "do": [
          {
            "sound": {
              "wave": "triangle",
              "note": "C6",
              "ms": 300
            }
          }
        ]
      }
    ]
  },
  "look": {
    "id": "neon",
    "tokens": {
      "primary": "#5EE6FF"
    }
  },
  "content": {},
  "playtest": {
    "progress": "lives * 1000"
  },
  "functions": {
    "colliders": {
      "params": {},
      "returns": "list<vec2>",
      "body": "map(spawns, s => vec(s.x, s.y))"
    }
  }
}