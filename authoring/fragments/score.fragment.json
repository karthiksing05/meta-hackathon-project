{
  "fragment": "score",
  "version": 1,
  "describe": "A score that goes up by `points` on each `point` event. With a target above 0, reaching it wins. Games may also write `score` directly.",
  "params": {
    "points": { "type": "int", "default": 1, "min": 1, "max": 1000 },
    "target": { "type": "int", "default": 0, "min": 0, "max": 100000 },
    "label":  { "type": "string", "default": "Score", "max_len": 16 }
  },
  "requires": {},
  "state": {
    "score": { "type": "int", "init": "0" }
  },
  "events": {
    "point": {}
  },
  "rules": [
    { "id": "add", "on": "point", "do": [ { "incr": "score", "by": "@points" } ] }
  ],
  "objectives": {
    "win": { "include": "@target > 0", "expr": "score >= @target" },
    "score": "score"
  },
  "presentation": {
    "slots": [
      {"slot":"hud_top","include":"@target > 0","node":{"ui":"stat","label":"@label","value":"= str(score) + ' / ' + str(@target)","color":"$ink","animate_on":{"point":{"prop":"scale","keys":[1,1.25,1],"ms":180}}}},
      {"slot":"hud_top","include":"@target == 0","node":{"ui":"stat","label":"@label","value":"= str(score)","color":"$ink","animate_on":{"point":{"prop":"scale","keys":[1,1.25,1],"ms":180}}}}
    ],
    "feedback": [
      { "on": "point", "do": [ { "moment": "pickup" } ] }
    ]
  },
  "tags": { "mood": ["any"], "energy": ["low", "medium", "high"] },
  "conflicts": []
}
