{
  "fragment": "gravity_jump",
  "version": 1,
  "describe": "Tap anywhere (or press Space or ArrowUp) to hop. Gravity pulls the avatar down to a floor at `floor_y`. Provides `player` (vec2: fixed `x`, y moves) and `vel_y` (px/s, negative is up). With `double_jump` on, one more hop is allowed in the air. Emits `jumped` on each hop and `landed` on touching the floor. Draws a floor line and the avatar in `playfield` (role avatar). Conflicts with player_drag and lanes, which also provide `player`.",
  "params": {
    "gravity":     { "type": "float", "default": 1800.0, "min": 200.0, "max": 5000.0 },
    "jump_vel":    { "type": "float", "default": 720.0, "min": 100.0, "max": 2000.0 },
    "floor_y":     { "type": "float", "default": 540.0, "min": 100.0, "max": 640.0 },
    "x":           { "type": "float", "default": 90.0, "min": 0.0, "max": 360.0 },
    "double_jump": { "type": "bool", "default": false },
    "size":        { "type": "float", "default": 16.0, "min": 4.0, "max": 40.0 },
    "tone":        { "type": "enum", "values": ["primary", "secondary", "accent", "ink", "danger"], "default": "primary" }
  },
  "requires": {},
  "state": {
    "player":  { "type": "vec2", "init": "vec(@x, @floor_y)" },
    "vel_y":   { "type": "float", "init": "0.0" },
    "_jumps":  { "type": "int", "init": "0" }
  },
  "events": {
    "jumped": {},
    "landed": {}
  },
  "inputs": {
    "_hop": {
      "payload": {},
      "from": [
        { "key": "ArrowUp", "with": {} },
        { "key": " ", "with": {} }
      ]
    }
  },
  "rules": [
    {
      "id": "hop",
      "on": "_hop",
      "when": "player.y >= @floor_y or (@double_jump and _jumps < 2)",
      "do": [
        { "set": "_jumps", "to": "if player.y >= @floor_y then 1 else 2" },
        { "set": "vel_y", "to": "-@jump_vel" },
        { "set": "player", "to": "vec(player.x, min(player.y, @floor_y - 1.0))" },
        { "emit": "jumped" }
      ]
    },
    {
      "id": "fall",
      "on": "tick",
      "when": "vel_y != 0.0 or player.y < @floor_y",
      "do": [
        { "let": { "v": "vel_y + @gravity * event.dt / 1000.0" } },
        { "let": { "y": "player.y + v * event.dt / 1000.0" } },
        { "if": "y >= @floor_y", "then": [
          { "set": "player", "to": "vec(player.x, @floor_y)" },
          { "set": "vel_y", "to": "0.0" },
          { "set": "_jumps", "to": "0" },
          { "emit": "landed" }
        ], "else": [
          { "set": "player", "to": "vec(player.x, y)" },
          { "set": "vel_y", "to": "v" }
        ] }
      ]
    }
  ],
  "objectives": {},
  "presentation": {
    "slots": [
      {
        "slot": "playfield",
        "node": {
          "node": "rect", "w": "@game.canvas_w", "h": "@game.canvas_h", "fill": "#00000000",
          "on_tap": { "input": "_hop", "with": {} }
        }
      },
      {
        "slot": "playfield",
        "node": { "node": "rect", "x": 0, "y": "= @floor_y + @size", "w": "@game.canvas_w", "h": "= @game.canvas_h - @floor_y - @size", "fill": "$surface" }
      },
      {
        "slot": "playfield",
        "node": {
          "node": "circle", "x": "= player.x", "y": "= player.y", "r": "@size",
          "fill": "= if @tone == 'primary' then $primary else if @tone == 'secondary' then $secondary else if @tone == 'accent' then $accent else if @tone == 'ink' then $ink else $danger",
          "role": "avatar"
        }
      }
    ],
    "feedback": [
      { "on": "jumped", "do": [ { "sound": { "wave": "square", "note": "E4", "ms": 60 } } ] }
    ]
  },
  "tags": { "mood": ["playful"], "energy": ["medium", "high"] },
  "conflicts": ["player_drag", "lanes"]
}
