{
  "fragment": "countdown",
  "version": 1,
  "describe": "A visible clock counting down from `ms`. Emits `time_up` when it reaches zero, and can end the game then. Doesn't set the game's time_limit. In the last `warn_at` ms the clock turns $danger and plays the `countdown` moment once a second.",
  "params": {
    "ms":      { "type": "duration", "default": "@game.duration_ms", "min": 1000, "max": 600000 },
    "on_end":  { "type": "enum", "values": ["none", "win", "lose"], "default": "none" },
    "warn_at": { "type": "duration", "default": 5000, "min": 0, "max": 60000 }
  },
  "requires": {},
  "events": {
    "time_up": {},
    "_warn_tick": {}
  },
  "rules": [
    {
      "id": "arm",
      "on": "start",
      "do": [ { "after": "@ms", "emit": "time_up", "id": "_timer" } ]
    },
    {
      "id": "finish",
      "on": "time_up",
      "include": "@on_end != 'none'",
      "do": [ { "end": "@on_end" } ]
    },
    {
      "id": "warn",
      "include": "@warn_at > 0",
      "on": { "every": "1000ms" },
      "when": "now < @ms and @ms - now <= @warn_at",
      "do": [ { "emit": "_warn_tick" } ]
    }
  ],
  "objectives": {},
  "presentation": {
    "slots": [
      {
        "slot": "hud_top",
        "node": {
          "node": "text",
          "text": "= str(max(0, ceil((@ms - now) / 1000.0))) + 's'",
          "size": 18, "weight": 600,
          "color": "= if @ms - now <= @warn_at then $danger else $ink",
          "transition": { "color": { "ms": 200, "ease": "out" } },
          "animate_on": { "_warn_tick": { "prop": "scale", "keys": [1, 1.3, 1], "ms": 200 } },
          "role": "hud"
        }
      }
    ],
    "feedback": [
      { "on": "_warn_tick", "do": [ { "moment": "countdown" } ] },
      { "on": "time_up", "include": "@on_end == 'none' and @ms < @game.duration_ms", "do": [ { "moment": "level" } ] }
    ]
  },
  "tags": { "mood": ["tense", "playful"], "energy": ["medium", "high"] },
  "conflicts": []
}
