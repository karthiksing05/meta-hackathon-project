{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game_type.schema.json",
  "title": "game_type",
  "description": "One game type: a distinct mechanic the harness can retrieve and plan from. See authoring/catalog/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "aliases", "family", "summary", "core_loop", "verbs", "inputs", "rules",
    "win", "scoring", "players", "tools", "gate_profile", "example_prompts", "status", "source"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "family": {
      "type": "string",
      "enum": [
        "word", "trivia", "knowledge_quiz", "logic_puzzle", "number_math", "spatial_puzzle", "tile_matching",
        "deduction", "memory", "reaction", "rhythm_music", "runner", "platformer", "arcade_shooter",
        "dodge_survive", "sports", "racing", "physics_toy", "stack_balance", "aim_throw", "catch_collect",
        "idle_incremental", "management_sim", "cooking_crafting", "nurture_pet", "card", "board", "dice_luck",
        "story_choice", "mystery_narrative", "adventure_rpg", "strategy_tactics", "tower_defense", "duel_battle",
        "party_social", "guess_your_friends", "drawing_creative", "music_making", "daily_puzzle", "learning",
        "calm_cozy", "horror_tension"
      ]
    },
    "subfamily": { "type": "string", "minLength": 1, "maxLength": 60 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 400 },
    "core_loop": { "type": "string", "minLength": 10, "maxLength": 400 },
    "verbs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z_ ]*$" } },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["tap", "drag", "swipe", "hold", "type", "tilt", "draw", "voice", "multi_touch"] }
    },
    "pieces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "win": { "type": "string", "minLength": 2 },
    "lose": { "type": "string", "minLength": 2 },
    "scoring": { "type": "string", "minLength": 2 },
    "session_seconds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 5, "maximum": 3600 }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["solo", "pass_and_play", "async_friends", "group_daily", "live"] }
    },
    "social_hooks": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "content_needs": { "type": "array", "items": { "type": "string", "minLength": 2 } },
    "difficulty_levers": { "type": "array", "items": { "type": "string", "minLength": 2 } },
    "tools": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" } },
    "engine_gaps": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" } },
    "gate_profile": { "type": "string", "enum": ["arcade", "puzzle", "calm", "trivia", "runner"] },
    "example_prompts": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3, "maxLength": 200 } },
    "status": { "type": "string", "enum": ["seed", "reviewed", "learned"] },
    "source": { "type": "string", "minLength": 2, "maxLength": 80 },
    "refs": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "variant_of": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
    "notes": { "type": "string" }
  }
}
