{
  "format": "microgame/0.1",
  "meta": {
    "title": "Snake",
    "instructions": "Swipe or use the arrow keys to steer. Eat 10 apples. Don't hit the walls or yourself.",
    "duration_s": 120
  },
  "state": {
    "score":    { "type": "int", "init": "0" },
    "snake":    { "type": "list<ivec2>", "init": "[vec(4, 7), vec(3, 7), vec(2, 7)]" },
    "dir":      { "type": "ivec2", "init": "right" },
    "next_dir": { "type": "ivec2", "init": "right" },
    "food":     { "type": "ivec2", "init": "vec(10, 7)" }
  },
  "events": {
    "point": {}
  },
  "inputs": {
    "steer": {
      "payload": { "dir": "ivec2" },
      "from": [
        { "swipe": "any",      "with": { "dir": "swipe.dir" } },
        { "key": "ArrowUp",    "with": { "dir": "up" } },
        { "key": "ArrowDown",  "with": { "dir": "down" } },
        { "key": "ArrowLeft",  "with": { "dir": "left" } },
        { "key": "ArrowRight", "with": { "dir": "right" } }
      ]
    }
  },
  "rules": [
    { "id": "score__add", "on": "point", "do": [ { "incr": "score", "by": "1" } ] },
    {
      "id": "steer",
      "on": "steer",
      "when": "event.dir + dir != vec(0, 0)",
      "do": [ { "set": "next_dir", "to": "event.dir" } ]
    },
    {
      "id": "move",
      "on": { "every": "150ms" },
      "do": [
        { "set": "dir", "to": "next_dir" },
        { "let": { "head": "snake[0] + dir" } },
        { "if": "not in_bounds(head, 15, 15) or contains(take(snake, len(snake) - 1), head)",
          "then": [ { "end": "lose" } ] },
        { "if": "head == food",
          "then": [
            { "set": "snake", "to": "concat([head], snake)" },
            { "emit": "point" },
            { "set": "food", "to": "pick(filter(coords(15, 15), c => not contains(snake, c)))" }
          ],
          "else": [
            { "set": "snake", "to": "concat([head], take(snake, len(snake) - 1))" }
          ] }
      ]
    }
  ],
  "objectives": {
    "win": "score >= 10",
    "score": "score",
    "time_limit": "120s",
    "on_timeout": "lose"
  },
  "presentation": {
    "canvas": { "w": 360, "h": 640, "background": "$bg" },
    "tokens": {
      "primary": "#7BD389", "secondary": "#3E8E5A", "accent": "#F2C14E", "ink": "#E8F5EA",
      "bg": "#0F1A12", "surface": "#16261A", "danger": "#FF5D5D",
      "body": "#7BD389", "head": "#C6F6CF", "food": "#FF5D5D"
    },
    "root": {
      "node": "group",
      "children": [
        {
          "node": "group", "x": 0, "y": 0,
          "children": [
            {
              "node": "grid", "cols": 15, "rows": 15, "cell_size": 22, "gap": 1, "x": 8, "y": 148,
              "cell": {
                "node": "rect", "w": 22, "h": 22, "radius": 4,
                "fill": "= if cell == food then $food else if cell == snake[0] then $head else if contains(snake, cell) then $body else $surface"
              }
            }
          ]
        },
        {
          "node": "stack", "dir": "row", "gap": 24, "align": "center",
          "x": 180, "y": 56, "anchor": "center",
          "children": [
            {
              "node": "text",
              "text": "= 'Apples' + ': ' + str(score) + ' / ' + str(10)",
              "size": 18, "weight": 600, "color": "$ink", "font": "Silkscreen"
            }
          ]
        },
        { "node": "stack", "dir": "row", "gap": 24, "align": "center", "x": 180, "y": 600, "anchor": "center", "children": [] },
        { "node": "group", "x": 0, "y": 0, "children": [] }
      ]
    },
    "feedback": [
      { "on": "point", "do": [ { "sound": { "wave": "sine", "note": "E5", "ms": 60 } } ] },
      { "on": "lose", "do": [ { "shake": { "px": 8, "ms": 300 } }, { "sound": { "wave": "square", "note": "C3", "ms": 250 } } ] },
      { "on": "win",  "do": [ { "sound": { "wave": "triangle", "note": "C6", "ms": 300 } } ] }
    ]
  }
}
