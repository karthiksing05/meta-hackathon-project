        "lines": [
          {
            "who": "Bo",
            "text": "Is that your car on the hill?"
          },
          {
            "who": "Tess",
            "text": "Yes! Just moved in. Is that okay?"
          },
          {
            "who": "Bo",
            "text": "Your wheels aren't curbed."
          },
          {
            "who": "Tess",
            "text": "What does curbed mean?"
