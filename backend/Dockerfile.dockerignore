# Only backend/ goes into the build context: not the iOS app, the engine, docs, or any env file.
*
!backend/go.mod
!backend/go.sum
!backend/cmd
!backend/internal
!backend/generator
# the one copy of what the images take from the app: the recommender, the game runtime and the engine/Studio bundles
!FacebookClone/Bubbles/Recommend/game-recs.js
!FacebookClone/Bubbles/Runtime/web
!FacebookClone/Bubbles/Studio/web/microgame-studio.js
# the game catalog the harness and dbinit read
!authoring/catalog
# the requirements code the planner runs in goja
!authoring/expander/requirements.mjs
# the modules behind the generator's compose hooks (backend/generator/src/hooks.mjs)
!authoring/expander/image-codec.mjs
!authoring/expander/layout-fix.mjs
!authoring/expander/engine.mjs
!authoring/playtest/layout-check.mjs
!authoring/playtest/bots.mjs
!authoring/playtest/frame-render.mjs
!authoring/expander/canvas.mjs
!authoring/expander/verify-layout.mjs
!authoring/playtest/fill-check.mjs
!authoring/playtest/requirements-check.mjs
# the blocking layout verifier (its checks are loaded from the folder; tests stay out)
!authoring/verify/*.mjs
!authoring/verify/checks/*.mjs
authoring/verify/test-*.mjs
# the look kit and its font metrics (backend/generator/src/hooks.mjs AUTHORING_FILES)
!authoring/expander/ui-style.mjs
!authoring/kit/look.mjs
!authoring/kit/font-data.mjs
!authoring/kit/vibes.mjs
!authoring/kit/readability.mjs
!authoring/kit/raster.mjs
!authoring/kit/jpeg.mjs
!authoring/kit/README.md
!authoring/fonts/fonts.json
!authoring/fonts/metrics.json
**/*_test.go
**/node_modules
**/*.env
