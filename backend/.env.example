# Local development only. Copy to .env (gitignored) and `set -a; . ./.env; set +a` before `go run`.
# Production values live on the server in /etc/game-platform/*.env; see deploy/env/ and docs/DEPLOYMENT.md.

# In-memory store: no database needed, data is lost on restart.
STORE=memory
# For a local MongoDB instead:
#   STORE=mongo
#   MONGO_URI=mongodb://bubbles_app:devpassword@127.0.0.1:27017/bubbles?authSource=bubbles
MONGO_DB=bubbles

JWT_SECRET=dev-only-secret-at-least-32-bytes-long!!
API_ADDR=:8080

# Local filesystem game storage. The API writes here; the games server serves <root>/published.
GAMES_ROOT=./data/games
GAMES_PUBLIC_DIR=./data/games/published
GAMES_ADDR=:8081
GAMES_BASE_URL=http://localhost:8081
