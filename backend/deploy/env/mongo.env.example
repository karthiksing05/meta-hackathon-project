# Copy to /etc/game-platform/mongo.env on the server (chmod 600, root:root). Never commit the real file.
# Read by the mongo container. The root user is for administration and backups only.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-long-random
# Least-privilege application user, created once by deploy/mongo-init.js (readWrite on one database).
MONGO_APP_DB=bubbles
MONGO_APP_USER=bubbles_app
MONGO_APP_PASSWORD=change-me-another-long-random
