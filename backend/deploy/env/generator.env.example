# Copy to /etc/game-platform/generator.env on the server (chmod 600, root:root). Never commit the real file.
# This is the ONLY place the Muse key lives. The app, the API and the repo never hold it.
MUSE_API_KEY=paste-the-muse-api-key-here
# Optional (these are the defaults):
# MUSE_BASE_URL=https://api.meta.ai/v1
# MUSE_MODEL=muse-wonder-1.0
# GENERATOR_MAX_CONCURRENT=2
# GENERATOR_JOB_TIMEOUT_SECONDS=780
# GENERATOR_LAYOUT=1           # layout fixes and lint around the gate (0 turns them off)
# Off unless set: GENERATOR_IMAGE_ART=1 has muse-image-1.0 draw an art-heavy plan's pictures (0 turns all picture art off)
