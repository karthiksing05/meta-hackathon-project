# Copy to /etc/game-platform/api.env on the server (chmod 600, root:root). Never commit the real file.
# The password must match MONGO_APP_PASSWORD. If it has special characters, URL-encode it.
MONGO_URI=mongodb://bubbles_app:change-me-another-long-random@mongo:27017/bubbles?authSource=bubbles
MONGO_DB=bubbles
# At least 32 random bytes:  openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48
# Public origin of the static game server (Cloudflare hostname), no trailing slash.
GAMES_BASE_URL=https://games.yourdomain.com
# Comma-separated browser origins allowed to call the API (native apps do not need CORS).
CORS_ORIGINS=
# The game-making harness (understand, retrieve, look up, plan) runs before each new game. On by default;
# set HARNESS_CONTEXT=0 to turn it off (games are then made without a context, as before).
#HARNESS_CONTEXT=0

# Brand accounts (usernames, comma separated) that may mark a game as sponsored: a brand's playable ad in the feed. Nobody else can.
# Real brand names are allowed. Without it, no game can be sponsored. Restart the api after changing it.
#SPONSOR_USERS=fizzco

# DEBUG ONLY: lets the debug viewer (games.<domain>/play/) delete any game with no sign-in. While this is on, anyone who can
# reach the API can delete any game. Turn it on while you are cleaning up, then remove it and restart the api.
#DEBUG_DELETE=1
# Optional limits
MAX_UPLOAD_MB=50
MAX_UNPACKED_MB=200

# NOTE: you do not have to edit this file on the server. Put switches (DEBUG_DELETE, SPONSOR_USERS, HARNESS_CONTEXT, ...) as
# KEY=VALUE lines in the GitHub environment variable API_ENV (and generator ones in GENERATOR_ENV); every deploy merges them in.
# The Mongo password and JWT_SECRET are generated on the server once and stay here: they must not change.
