# Copy to /etc/game-platform/api.env on the server (chmod 600, root:root). Never commit the real file.
# The password must match MONGO_APP_PASSWORD. If it has special characters, URL-encode it.
MONGO_URI=mongodb://bubbles_app:change-me-another-long-random@mongo:27017/bubbles?authSource=bubbles
MONGO_DB=bubbles
# At least 32 random bytes:  openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48
# Public origin of the static game server (Cloudflare hostname), no trailing slash.
GAMES_BASE_URL=https://games.yourdomain.com
# Comma-separated browser origins allowed to call the API (native apps do not need CORS).
CORS_ORIGINS=
# Optional limits
MAX_UPLOAD_MB=50
MAX_UNPACKED_MB=200
