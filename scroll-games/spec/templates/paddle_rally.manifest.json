{
  "schema": "sg.manifest/1",
  "title": "Rally",
  "description": "Keep the ball in play with your paddle.",
  "level": "remix",
  "template": "paddle_rally",
  "seed_scope": "per_challenge",
  "concepts": [
    {
      "id": "flow.session",
      "params": {}
    },
    {
      "id": "flow.countdown_start",
      "params": {
        "seconds": 3
      }
    },
    {
      "id": "space.physics_world",
      "params": {
        "gravity": 0.0
      }
    },
    {
      "id": "entity.paddle",
      "params": {
        "width": 90
      }
    },
    {
      "id": "entity.bouncing_ball",
      "params": {
        "radius": 11,
        "elasticity": 1.0
      }
    },
    {
      "id": "input.drag_drop",
      "params": {
        "snap_radius": 24
      }
    },
    {
      "id": "behavior.follow_finger",
      "params": {
        "smoothing": 0.15
      }
    },
    {
      "id": "rule.collision",
      "params": {
        "precision": "box"
      }
    },
    {
      "id": "rule.lives",
      "params": {
        "lives": 3
      }
    },
    {
      "id": "rule.total_time_limit",
      "params": {
        "limit_ms": 60000
      }
    },
    {
      "id": "feel.theme",
      "params": {
        "palette": "ocean",
        "mood": "playful",
        "emoji": "🏓"
      }
    },
    {
      "id": "share.score_card",
      "params": {
        "headline": "Final score"
      }
    },
    {
      "id": "social.beat_them",
      "params": {}
    }
  ],
  "glue": [
    {
      "id": "rally_points",
      "on": [
        "collision.hit"
      ],
      "script": "fn on_event(ev) {\n    if ev.data.b == \"paddle\" {\n        set(\"score\", get(\"score\") + 10);\n        emit(\"feedback.haptic\", #{ style: \"light\" });\n    } else if ev.data.harm == true {\n        emit(\"feedback.flash\", #{ color: \"red\" });\n    }\n}\n"
    }
  ],
  "theme": {
    "palette": "ocean",
    "mood": "playful",
    "emoji": "🏓"
  }
}
