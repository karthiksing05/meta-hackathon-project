{
  "schema": "sg.manifest/1",
  "title": "Star Catcher",
  "description": "Drag to catch stars and avoid the bombs.",
  "level": "remix",
  "template": "star_catcher",
  "seed_scope": "per_challenge",
  "concepts": [
    {
      "id": "flow.session",
      "params": {}
    },
    {
      "id": "flow.countdown_start",
      "params": {
        "seconds": 3
      }
    },
    {
      "id": "space.physics_world",
      "params": {
        "gravity": 0.0
      }
    },
    {
      "id": "entity.player_avatar",
      "params": {
        "emoji": "🧺",
        "size": 56
      }
    },
    {
      "id": "entity.collectible",
      "params": {
        "value": 10,
        "emoji": "⭐"
      }
    },
    {
      "id": "entity.obstacle",
      "params": {
        "damage": 1,
        "emoji": "💣"
      }
    },
    {
      "id": "behavior.spawn_wave",
      "params": {
        "every_ms": 700
      }
    },
    {
      "id": "behavior.magnet",
      "params": {
        "radius": 70
      }
    },
    {
      "id": "behavior.gravity",
      "params": {
        "strength": 2.0
      }
    },
    {
      "id": "input.drag_drop",
      "params": {
        "snap_radius": 24
      }
    },
    {
      "id": "behavior.follow_finger",
      "params": {
        "smoothing": 0.1
      }
    },
    {
      "id": "rule.collision",
      "params": {
        "precision": "circle"
      }
    },
    {
      "id": "rule.lives",
      "params": {
        "lives": 3
      }
    },
    {
      "id": "rule.total_time_limit",
      "params": {
        "limit_ms": 45000
      }
    },
    {
      "id": "feel.theme",
      "params": {
        "palette": "midnight",
        "mood": "playful",
        "emoji": "⭐"
      }
    },
    {
      "id": "share.score_card",
      "params": {
        "headline": "Final score"
      }
    },
    {
      "id": "social.beat_them",
      "params": {}
    }
  ],
  "glue": [
    {
      "id": "juice",
      "on": [
        "entity.collected",
        "collision.hit"
      ],
      "script": "fn on_event(ev) {\n    if ev.name == \"entity.collected\" {\n        emit(\"feedback.haptic\", #{ style: \"light\" });\n    } else if ev.data.harm == true {\n        emit(\"feedback.flash\", #{ color: \"red\" });\n        emit(\"feedback.haptic\", #{ style: \"error\" });\n    }\n}\n"
    }
  ],
  "theme": {
    "palette": "midnight",
    "mood": "playful",
    "emoji": "⭐"
  }
}
